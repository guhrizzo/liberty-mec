# Copie para .env (não versionar). Em produção (Render) configure estas variáveis no painel.

# Em produção: a "Internal Database URL" do Postgres da Render.
# Vazio = usa Postgres embutido (PGlite) em ./.data, só para desenvolvimento.
DATABASE_URL=

# Obrigatório em produção, mínimo 32 caracteres aleatórios. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Sites que podem chamar a API, separados por vírgula.
CORS_ORIGIN=https://liberty-mec.vercel.app,http://localhost:5173

PORT=3001
